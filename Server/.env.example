# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local example: mongodb://127.0.0.1:27017/lumiere_restaurant
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/lumiere_restaurant?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/lumiere_restaurant

# JWT Secret Key for Authentication
JWT_SECRET=lumiere_restaurant_super_secret_key_12345
